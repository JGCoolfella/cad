{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCAD",
  "version": "0.9.0",
  "identifier": "nz.co.greendealer.opencad",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "JGCoolfella",
    "copyright": "Copyright © 2026 JGCoolfella",
    "category": "GraphicsAndDesign",
    "homepage": "https://cad.greendealer.co.nz",
    "shortDescription": "OpenCAD",
    "longDescription": "A parametric 3D CAD application with a familiar workflow.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "startMenuFolder": "OpenCAD"
      }
    }
  }
}
