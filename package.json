{
  "name": "opencad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A modern, from-scratch parametric 3D CAD application with a SOLIDWORKS-compatible user experience.",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop": "vite build && electron .",
    "desktop:dev": "electron . --dev"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "replicad": "^1.2.1",
    "replicad-opencascadejs": "^1.2.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
