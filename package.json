{
  "name": "opencad",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "A modern, from-scratch parametric 3D CAD application with a SOLIDWORKS-compatible user experience.",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop": "vite build && electron .",
    "desktop:dev": "electron . --dev",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:native:win": "node scripts/dist-native.mjs",
    "test:native:install": "node scripts/test-native-install.mjs",
    "deploy:web": "bash scripts/deploy-web.sh",
    "build:sketch-wasm": "node scripts/build-sketch-wasm.mjs",
    "native": "npm run build && cargo run -p oc-app --release --features custom-protocol",
    "native:dev": "cargo run -p oc-app",
    "native:smoke": "npm run build && cargo run -p oc-app --release --features custom-protocol -- --smoke=native-smoke.png",
    "native:corpus": "npm run build && cargo run -p oc-app --release --features custom-protocol -- --corpus --smoke=native-corpus.png",
    "native:picking": "npm run build && cargo run -p oc-app --release --features custom-protocol -- --script=crates/oc-app/scripts/picking.js --smoke=native-picking.png",
    "native:assembly": "npm run build && cargo run -p oc-app --release --features custom-protocol -- --script=crates/oc-app/scripts/assembly.js --smoke=native-assembly.png",
    "native:configurations": "npm run build && cargo run -p oc-app --release --features custom-protocol -- --script=crates/oc-app/scripts/configurations.js --smoke=native-configurations.png",
    "native:lod": "npm run build && cargo run -p oc-app --release --features custom-protocol -- --script=crates/oc-app/scripts/lod.js --smoke=native-lod.png"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "replicad": "^1.2.1",
    "replicad-opencascadejs": "^1.2.1",
    "three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "author": {
    "name": "JGCoolfella"
  },
  "homepage": "https://cad.greendealer.co.nz",
  "repository": {
    "type": "git",
    "url": "https://github.com/JGCoolfella/cad.git"
  },
  "build": {
    "appId": "nz.co.greendealer.opencad",
    "productName": "OpenCAD",
    "copyright": "Copyright © 2026 JGCoolfella",
    "artifactName": "OpenCAD-Electron-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenCAD"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "OpenCAD ${version}"
    },
    "publish": {
      "provider": "github",
      "owner": "JGCoolfella",
      "repo": "cad",
      "releaseType": "release"
    }
  }
}
